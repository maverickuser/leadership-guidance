# Copy to .env (git-ignored). Values here are read by the archive CLI and by docker compose.
# One cookie per newsletter: each source's cookie_env in config.yaml names its variable here.
NEWSLETTER_COOKIE=
# PRAGMATIC_ENGINEER_COOKIE=

# Search (openspec add-hybrid-search)
GEMINI_API_KEY=
# Search database (docker compose up -d --wait db). Pick long random values, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ARCHIVE_DB_ADMIN_PASSWORD=
ARCHIVE_DB_WRITER_PASSWORD=
ARCHIVE_DB_READER_PASSWORD=
